# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/noteshub

# JWT (change this in production!)
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Optional: seed admin on first run via npm run seed
ADMIN_NAME=Fragy Admin
ADMIN_EMAIL=admin@fragy.local
ADMIN_PASSWORD=AdminPass123!

# Nodemailer (optional — leave blank to skip sending mail in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NotesHub <noreply@noteshub.local>"

